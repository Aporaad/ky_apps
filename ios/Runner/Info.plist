<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>ar</string>
	<!-- تطبيق عربي أولاً: إعلان العربية لغة التطبيق الوحيدة يجعل حوارات النظام
		 (أذونات الصور/الشبكة، وورقة المشاركة) تظهر بالعربية أيضاً.
		 Arabic-first: declaring Arabic as the only app localization makes the system dialogs
		 (photo/network permissions and the share sheet) appear in Arabic as well. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>ar</string>
	</array>
	<!-- يطلبه share_plus لخلط لغة التطبيق مع لغة الجهاز في ورقة المشاركة.
		 Required by share_plus so the share sheet may mix app and device localizations. -->
	<key>CFBundleAllowMixedLocalizations</key>
	<true/>
	<key>NSFaceIDUsageDescription</key>
	<string>يستخدم التطبيق Face ID لتسجيل الدخول بشكل آمن وسريع</string>
	<!-- إذن قراءة معرض الصور — يطلبه زر «اختيار الشعار» في إعدادات الهوية (image_picker).
		 Photo-library permission — requested by the logo picker in the identity settings (image_picker).
		 غيابه يُنهي التطبيق فوراً عند النقر على الزر على iOS؛ لا يُحذف أبداً.
		 Without it iOS terminates the app the moment the button is tapped; never remove it. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>يُستخدم للوصول إلى معرض الصور لاختيار شعار الشركة في إعدادات الهوية</string>
	<!-- إيصال إفصاح الشبكة المحلية — iOS 14+ يسأل قبل أي اتصال بعنوان خاص (192.168.x.x).
		 Local-network privacy disclosure — iOS 14+ prompts before reaching a private address. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>يتصل التطبيق بخادم الشركة على الشبكة المحلية لجلب البيانات</string>
	<!-- استثناء ATS: عنوان الـ API يُضبط وقت التشغيل ويمكن أن يكون http على IP محلي، وهو ما
		 يمنعه App Transport Security افتراضياً فيفشل كل اتصال بصمت. يُضيَّق أو يُزال عند
		 نشر الخادم على HTTPS (راجع ios_release_guide.md §6).
		 ATS exception: the API base URL is set at runtime and may be plain http on a LAN IP, which
		 ATS blocks by default (every request then fails silently). Narrow or remove once the server
		 serves HTTPS (see ios_release_guide.md §6). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>CFBundleDisplayName</key>
	<string>الكبودي</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>ky_apps</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
</dict>
</plist>
